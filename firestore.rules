rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  ⚠️  NO PUBLICAR ESTAS REGLAS HASTA SEMBRAR LA LISTA /staff (abajo).   ║
    // ║  isStaff() ahora exige que el UID esté en /staff/{uid}. Si se publican ║
    // ║  ANTES de cargar los UID del personal, TODO el personal pierde acceso  ║
    // ║  (admin y choferes). Orden correcto:                                   ║
    // ║   1) Crear en la consola Firestore la colección 'staff' con un doc por  ║
    // ║      cada empleado, ID = su UID de Firebase Auth (Authentication→Users).║
    // ║   2) Verificar que admin/chofer siguen entrando.                        ║
    // ║   3) Recién entonces publicar estas reglas.                             ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    // ORDEN PARA PUBLICAR ESTA VERSIÓN (rama 'seguridad', nov. 2026): primero
    // tienen que estar EN VIVO las páginas nuevas de gdo-tienda (seguir.html,
    // juego.html) y de gdo-reparto (js/data.js publica /seguimiento). Recién
    // después se pegan estas reglas en la consola. Las páginas nuevas funcionan
    // con las reglas viejas y con estas; las viejas NO con estas (el juego y el
    // ETA del seguimiento). Pruebas: test/rules.test.js (emulador).

    // ───────── Identidad ─────────
    // PERSONAL (staff): su UID de Firebase Auth figura en la lista blanca /staff.
    // Antes "staff" = cualquiera no-anónimo; YA NO alcanza, porque los SOCIOS del
    // Club GDO también entran con email+contraseña. Sin esta lista, un cliente
    // tendría permisos de administrador. ← clave anti-estafa.
    // OJO: la colección en Firestore se llama "Staff" con S MAYÚSCULA (así se creó
    // en la consola, y Firestore distingue mayúsculas). Si sumás personal, creá el
    // doc dentro de "Staff" (no "staff"), ID = el UID de Auth del empleado.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/Staff/$(request.auth.uid));
    }
    // Dueño de un documento identificado por UID.
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // ADMIN vs CAJERO/REPARTIDOR. Antes TODO el personal (isStaff) tenía permisos
    // de admin en Firestore; la restricción del cajero era SOLO de interfaz. Ahora
    // las operaciones peligrosas (borrar socios, editar el catálogo de premios,
    // borrar canjes, prender/apagar el canje) exigen isAdmin().
    // RETROCOMPATIBLE: un doc /Staff SIN campo 'rol' cuenta como 'admin' (así
    // publicar estas reglas NO saca permisos a nadie). Para limitar a un cajero,
    // agregá  rol: "cajero"  (o "repartidor") a su doc en /Staff.
    function isAdmin() {
      return isStaff()
        && get(/databases/$(database)/documents/Staff/$(request.auth.uid)).data.get('rol', 'admin') == 'admin';
    }

    // Rol del personal tal como figura en /Staff (sin campo = 'admin', ver arriba).
    // Solo tiene sentido después de isStaff().
    function rolStaff() {
      return get(/databases/$(database)/documents/Staff/$(request.auth.uid)).data.get('rol', 'admin');
    }

    // CRM (ficha de clientes): el admin siempre; el resto del personal solo si su
    // doc en /Staff tiene  crm: true. Ver la nota completa en /crm_clientes.
    function puedeCRM() {
      return isAdmin()
        || (isStaff()
            && get(/databases/$(database)/documents/Staff/$(request.auth.uid)).data.get('crm', false) == true);
    }

    // PROMOS de la tienda: mismo criterio, con  promos: true  en /Staff.
    // Ojo: esto no es mirar datos, es PUBLICAR. Lo que active esa persona lo ve
    // todo el que entra a la lista de precios, al instante.
    function puedePromos() {
      return isAdmin()
        || (isStaff()
            && get(/databases/$(database)/documents/Staff/$(request.auth.uid)).data.get('promos', false) == true);
    }

    /* ───────── Puntos del Club: el cajero SOLO carga contra ticket ─────────
       El personal que NO es admin (cajero) puede tocar el saldo de un socio
       únicamente para SUMARLE los puntos de un ticket que se está creando en el
       MISMO commit. La pantalla ya lo obliga a escanear, pero eso es solo la
       pantalla: esto es el candado del lado del servidor.

       Qué se exige:
       · que solo cambien 'puntos' y 'ultimoTicket' (nada de nombre, DNI, etc.);
       · que 'ultimoTicket' apunte a un /tickets que se crea en este mismo commit
         (getAfter), sea de ESTE socio y lo esté cargando ESTE empleado;
       · que los puntos sumados sean EXACTAMENTE los del ticket — ni uno más.
       La foto y la cuenta puntos↔monto las valida la regla de /tickets. */
    function ticketDelCommit() {
      return getAfter(/databases/$(database)/documents/tickets/$(request.resource.data.ultimoTicket)).data;
    }
    function creditoConTicket(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puntos', 'ultimoTicket'])
        && request.resource.data.ultimoTicket is string
        && existsAfter(/databases/$(database)/documents/tickets/$(request.resource.data.ultimoTicket))
        && ticketDelCommit().clienteUid == uid
        && ticketDelCommit().por == request.auth.uid
        && request.resource.data.puntos == resource.data.puntos + ticketDelCommit().puntos;
    }

    // Texto opcional: si viene, tiene que ser string (o null) y no más largo que max.
    function txt(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    // Número opcional (o null).
    function num(d, k) {
      return !(k in d) || d[k] == null || d[k] is number;
    }

    /* Código de descuento VIGENTE para un pedido de la tienda: existe, el % es
       el del código real, no está pausado ni vencido (fecha del SERVIDOR; vale
       todo el día del vencimiento, hora Argentina = UTC-3 → +27 h desde las 0 UTC)
       y, si es PERSONAL con teléfono, el teléfono del pedido termina en esos 8
       dígitos. Antes esto último y lo de pausado/vencido lo miraba solo el
       navegador. Lo que queda para el panel: "ya usado" (sale de los pedidos). */
    function descuentoValido(d) {
      let x = d.descuento;
      let ref = /databases/$(database)/documents/descuentos/$(x.codigo);
      let c = get(ref).data;
      let v = c.get('vence', '');
      return x is map
        && x.keys().hasOnly(['codigo', 'pct', 'tipo', 'nombre', 'subtotal', 'monto'])
        && x.codigo is string && x.codigo.size() > 0 && x.codigo.size() <= 30
        && exists(ref)
        && x.pct == c.pct
        && txt(x, 'tipo', 20) && txt(x, 'nombre', 80) && num(x, 'subtotal') && num(x, 'monto')
        && c.get('activo', true) != false
        && (v == '' || v == null
            || request.time < timestamp.date(int(v.split('-')[0]), int(v.split('-')[1]), int(v.split('-')[2])) + duration.value(27, 'h'))
        && (c.get('tipo', '') != 'personal' || c.get('tel8', '') == ''
            || d.telefono.replace('[^0-9]', '').matches('^[0-9]*' + c.tel8 + '$'));
    }

    // Validación de un pedido creado por la tienda (sesión anónima o socio
    // logueado). Limita lo que un no-staff puede escribir. Si trae clienteUid,
    // debe ser el del propio usuario (para acreditar puntos a quien corresponde).
    //
    // LISTA CERRADA DE CAMPOS (keys().hasOnly): son exactamente los que mandan
    // los formularios de gdo-tienda (index.html — lista y link de vendedor —,
    // vista-minorista.html, combo.html, suprema.html). Si se agrega un campo
    // nuevo en la tienda, HAY QUE SUMARLO ACÁ o los pedidos se rechazan.
    // Quedan afuera a propósito: pagado / pagoOnline (los marca el servidor del
    // bot al confirmar Nave), pod (comprobante del chofer), puntos /
    // puntosAcreditados (los decide el personal).
    // El id del documento tiene que ser el que genera la tienda: p_ + 32
    // caracteres base36 (o el respaldo sin crypto, más corto). Así no se cuela
    // HTML en el id, que el panel mete en atributos.
    // Los renglones (items) NO se pueden revisar uno por uno (las reglas no
    // tienen bucles): se limita la cantidad y el panel escapa todo al mostrarlo.
    // precio / totalEstimado / descuento.monto los calcula el NAVEGADOR del
    // cliente: son una referencia, NUNCA un monto confiable (el panel lo avisa).
    function pedidoTiendaValido(id) {
      let d = request.resource.data;
      return id.matches('^p_[A-Za-z0-9_-]{12,48}$')
        && d.id == id
        && d.keys().hasOnly(['id', 'origen', 'canal', 'lista', 'fuente', 'vendedorId', 'vendedorNombre',
             'cliente', 'contacto', 'telefono', 'fantasia', 'razonSocial', 'cuit', 'email',
             'modalidad', 'direccion', 'localidad', 'entrecalles', 'lat', 'lng', 'zona', 'envio',
             'items', 'fechaEntrega', 'diaEntrega', 'ventana', 'especificaciones', 'formaPago',
             'prioridad', 'estado', 'creadoPor', 'rutaId', 'clienteUid', 'cuentaUid',
             'totalEstimado', 'descuento', 'historia', 'creado', 'ts'])
        && d.origen == 'tienda'
        && d.estado == 'pendiente'
        && d.rutaId == null
        && d.creadoPor == null
        && d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 120
        && d.telefono is string && d.telefono.size() <= 40
        && d.direccion is string && d.direccion.size() <= 300
        && d.especificaciones is string && d.especificaciones.size() <= 2000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 100
        && (!('historia' in d) || (d.historia is list && d.historia.size() == 0))
        && (!('prioridad' in d) || d.prioridad == 'normal')
        && (!('modalidad' in d) || d.modalidad in ['envio', 'retiro'])
        && (!('lista' in d) || d.lista in ['mayorista', 'minorista'])
        && (!('canal' in d) || d.canal == 'vendedor')
        && (!('vendedorId' in d) || (d.vendedorId is string && d.vendedorId.matches('^[A-Za-z0-9_-]{1,60}$')))
        && num(d, 'lat') && num(d, 'lng') && num(d, 'envio') && num(d, 'totalEstimado')
        && num(d, 'creado') && num(d, 'ts')
        && txt(d, 'fuente', 60) && txt(d, 'vendedorNombre', 80) && txt(d, 'contacto', 120)
        && txt(d, 'fantasia', 120) && txt(d, 'razonSocial', 160) && txt(d, 'cuit', 20) && txt(d, 'email', 120)
        && txt(d, 'localidad', 120) && txt(d, 'entrecalles', 200) && txt(d, 'zona', 80)
        && txt(d, 'fechaEntrega', 10) && txt(d, 'diaEntrega', 60) && txt(d, 'ventana', 60) && txt(d, 'formaPago', 80)
        && (!('clienteUid' in d) || d.clienteUid == null || d.clienteUid == request.auth.uid)
        && (!('cuentaUid' in d) || d.cuentaUid == null || d.cuentaUid == request.auth.uid)
        // Anti-estafa: si el pedido trae un CÓDIGO DE DESCUENTO, el código tiene
        // que existir, el % tiene que ser el del código real (el cliente no puede
        // inventarse un 50%) y tiene que estar vigente (ver descuentoValido).
        && (!('descuento' in d) || d.descuento == null || descuentoValido(d));
    }

    // ───────── Lista blanca de personal ─────────
    // BOOTSTRAP: el primer doc se crea desde la consola (las escrituras de consola
    // saltean las reglas). Después, el personal existente puede sumar más personal.
    // Colección "Staff" con S MAYÚSCULA (ver nota en isStaff()).
    match /Staff/{uid} {
      allow read: if isStaff();
      // SOLO un ADMIN toca la lista de personal. Antes era isStaff(), y eso dejaba
      // un agujero grande: el cajero podía editar SU PROPIO doc, borrarse el campo
      // rol: "cajero" y pasar a ser admin (isAdmin() trata como admin al doc sin
      // rol, por retrocompatibilidad). Con eso se salteaba todo lo de abajo.
      allow create, update, delete: if isAdmin();
    }

    // ───────── Datos internos: SOLO personal ─────────
    // Perfiles de la app (nombre, roles de PANTALLA, comisiones). Antes cualquier
    // staff los escribía: un repartidor podía ponerse roles: ['admin'] y la app
    // le mostraba todo (las reglas igual miran /Staff, pero muchas colecciones
    // solo piden isStaff). Ahora escribe el ADMIN, salvo dos cosas que hace la
    // propia app al primer ingreso (Store.login en js/data.js):
    //  · crear SU perfil (id = su UID) como repartidor;
    //  · anotar SU UID en el perfil que tiene SU email.
    // (y la limpieza vieja de un campo 'pass', que solo puede BORRARLO).
    match /users/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
      allow create: if isStaff() && id == request.auth.uid
                       && request.resource.data.keys().hasOnly(['id', 'uid', 'nombre', 'email', 'roles', 'activo'])
                       && request.resource.data.uid == request.auth.uid
                       && request.resource.data.roles == ['repartidor'];
      allow update: if isStaff()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
                       && request.resource.data.uid == request.auth.uid
                       && request.auth.token.email is string
                       && resource.data.get('email', '').lower() == request.auth.token.email.lower();
      allow update: if isStaff()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pass'])
                       && !('pass' in request.resource.data);
    }
    match /vehiculos/{id}       { allow read, write: if isStaff(); }
    match /notificaciones/{id}  { allow read, write: if isStaff(); }
    match /meta/{id}            { allow read, write: if isStaff(); }

    // CRM: ficha comercial del cliente (tipo, notas, recordatorios, "ya lo
    // contacté"). NO confundir con /clientes, que es la del socio del GDO CLUB.
    // Son datos de contacto de terceros + el historial de compras del negocio:
    // NO lo ve cualquiera que carga un pedido, y nunca hay lectura pública.
    //
    // Quién entra: el ADMIN siempre; el resto del personal solo si su doc en
    // /Staff tiene  crm: true. En la app el permiso se marca en "Usuarios y
    // roles" (eso decide si le aparece la pestaña); esta regla es el candado de
    // verdad, del lado del servidor. RETROCOMPATIBLE: un doc /Staff sin 'rol'
    // cuenta como admin, así que publicar esto no le saca el acceso a nadie hoy.
    match /crm_clientes/{id}    { allow read, write: if puedeCRM(); }

    // ───────── Promos de la tienda ─────────
    // Las imágenes verticales (formato estado de WhatsApp) que rotan arriba de la
    // lista de precios. LECTURA PÚBLICA a propósito: son piezas de publicidad,
    // hechas para que las vea cualquiera, y la lista se abre sin login. No hay
    // ningún dato personal acá.
    //
    // Subirlas y borrarlas: el ADMIN siempre, y el resto del personal solo si su
    // doc en /Staff tiene  promos: true  (en la app el permiso se marca en
    // "Usuarios y roles"; esta regla es el candado del lado del servidor).
    // La imagen va embebida como dataURL dentro del documento (Firebase Storage
    // no entra en el plan gratis), por eso se comprime a ~150 KB antes de subir.
    match /promos/{id} {
      allow read:  if true;
      allow write: if puedePromos();
    }

    // ───────── Códigos de descuento ─────────
    // El id del documento ES el código (VOLVE10, VOLVE-7K3QM9XA). La tienda
    // busca UNO por su nombre para validarlo antes de mandar el pedido: get
    // público, como el seguimiento (hay que saber el código para leerlo), pero
    // NO puede listar los demás. El personal los ve todos: hacen falta al cargar
    // un pedido desde el panel.
    // OJO: el doc de un código PERSONAL lleva clienteNombre y tel8; lo puede leer
    // quien tenga el código (el propio cliente). Por eso los personales nuevos
    // son VOLVE-<8 al azar> (no se pueden adivinar). Los viejos VOLVE-NOMBRE-XXX
    // sí: conviene pausarlos y mandar uno nuevo si todavía importan.
    // Crear/editar: quien maneja Promos. Los códigos PERSONALES también los crea
    // quien tiene el CRM: se generan desde la ficha del cliente que se está yendo.
    match /descuentos/{id} {
      allow get:  if true;
      allow list: if isStaff();
      allow create, update: if puedePromos()
                            || (puedeCRM() && request.resource.data.tipo == 'personal');
      allow delete: if puedePromos();
    }

    // ───────── Pedidos ─────────
    // get: el cliente final ve SU pedido por el link de seguimiento (id de 128
    //      bits, no adivinable). create: personal (cualquier origen) o tienda
    //      (anónimo/socio) si pasa la validación. list/update: personal.
    // delete: el ADMIN; el vendedor y el cajero solo un pedido que todavía está
    //      pendiente y sin ruta (corregir una carga). El repartidor no borra.
    match /pedidos/{id} {
      allow get: if true;
      allow create: if isStaff() || (request.auth != null && pedidoTiendaValido(id));
      allow list, update: if isStaff();
      allow delete: if isAdmin()
                    || (isStaff() && rolStaff() in ['vendedor', 'cajero']
                        && resource.data.get('estado', '') == 'pendiente'
                        && resource.data.get('rutaId', null) == null);
    }

    // ───────── Rutas ─────────
    // SOLO personal. Antes tenía get público (para el seguimiento) y la ruta
    // trae los ids de los pedidos de todas las paradas: con un link de
    // seguimiento se sacaban nombre, teléfono y dirección de toda la ruta.
    match /rutas/{id} {
      allow read, write: if isStaff();
    }

    // Copia PÚBLICA de la ruta para el link de seguimiento (la escribe la app de
    // reparto: publicarSeguimiento en js/data.js). Sin datos personales: chofer,
    // depósito, demoras y paradas como fichas SHA-256 + estado + coords ~100 m.
    match /seguimiento/{id} {
      allow get:  if true;
      allow list: if isStaff();
      allow create, update: if isStaff()
                       && request.resource.data.keys().hasOnly(['estado', 'origen', 'choferPos', 'demoraDefaultMin', 'paradas', 'actualizado'])
                       && request.resource.data.paradas is list
                       && request.resource.data.paradas.size() <= 200;
      allow delete: if isStaff();
    }

    // ═══════════════════════ CLUB GDO ═══════════════════════
    // Regla de oro anti-estafa: el SOCIO nunca escribe sus puntos. Solo MIRA su
    // saldo y PIDE canjes. Sumar/restar puntos = SOLO personal (acreditación por
    // entrega o carga manual), y queda registrado en /puntos_log.

    // Perfil + saldo del socio (doc ID = UID de Firebase Auth del socio).
    // Contador del número de socio (ver /club_config).
    function contador() { return /databases/$(database)/documents/club_config/contador; }

    match /clientes/{uid} {
      allow get:    if isOwner(uid) || isStaff();
      // Listar socios (DNI, teléfono de todos): admin y cajero (búsqueda por N° de
      // socio en el mostrador, pestaña Club). El repartidor y el vendedor no:
      // el chofer lee UN socio por su id al acreditar, eso es 'get'.
      allow list:   if isAdmin() || (isStaff() && rolStaff() == 'cajero');
      // Alta: el propio socio, arrancando SIEMPRE en 0 puntos, sin 'juegoIlimitado'
      // (cuenta de demo, la marca el personal) y con el N° de socio que le tocó:
      // el que deja el contador en ESTE MISMO commit (club.html crearSocio lo
      // incrementa en la misma transacción; la regla del contador obliga a +1).
      // Así nadie se elige un número. Las cuentas MAYORISTAS (link de vendedor)
      // no son socios: van con nroSocio 0 y tipo 'mayorista'. O el personal.
      allow create: if isStaff() || (isOwner(uid)
                       && request.resource.data.puntos == 0
                       && !('juegoIlimitado' in request.resource.data)
                       && ((request.resource.data.nroSocio == 0 && request.resource.data.get('tipo', '') == 'mayorista')
                           || (request.resource.data.nroSocio is int
                               && request.resource.data.nroSocio == getAfter(contador()).data.n
                               && (!exists(contador()) || get(contador()).data.n != getAfter(contador()).data.n))));
      // Update por el socio: puede tocar sus datos y BAJAR puntos (para canjear),
      // NUNCA subirlos (sumar = solo personal) ni cambiar 'nroSocio'. La baja real
      // queda atada a un voucher válido por la regla de /canjes (getAfter).
      // El ADMIN edita todo. El CAJERO (y cualquier staff que no sea admin) SOLO
      // puede SUMAR puntos, y SOLO contra un ticket escaneado: ver creditoConTicket().
      // Antes le alcanzaba con tocar 'puntos' y podía ponerle el número que quisiera
      // desde la consola del navegador, salteándose la pantalla de escaneo.
      // El socio tampoco cambia su DNI (es la llave del límite diario del juego)
      // ni se marca 'juegoIlimitado'. Si hay que corregir el DNI, lo hace un admin.
      allow update: if isAdmin()
                    || (isStaff() && creditoConTicket(uid))
                    || (isOwner(uid)
                        && request.resource.data.get('nroSocio', null) == resource.data.get('nroSocio', null)
                        && request.resource.data.get('dni', null) == resource.data.get('dni', null)
                        && request.resource.data.get('juegoIlimitado', null) == resource.data.get('juegoIlimitado', null)
                        && request.resource.data.puntos is int
                        && request.resource.data.puntos >= 0
                        && request.resource.data.puntos <= resource.data.puntos);
      // Borrar la cuenta: un ADMIN, o el PROPIO socio (autoservicio, baja de datos).
      // Un cajero NO borra socios.
      allow delete: if isAdmin() || isOwner(uid);
    }

    // ── Candado "1 canje de cada premio por MES CALENDARIO" (anti cambio de fecha) ──
    // El mes lo decide el SERVIDOR (request.time), NUNCA el reloj del cliente: cambiar
    // la fecha de la PC no sirve. Doc id = premioId; guarda ts = serverTimestamp.
    // Solo se puede (re)escribir si el mes GUARDADO es DISTINTO al mes actual del
    // servidor → no se repite el mismo premio dentro del mismo mes calendario.
    match /clientes/{uid}/canje_meses/{premioId} {
      allow read:   if isOwner(uid) || isStaff();
      allow create: if isOwner(uid) && request.resource.data.ts == request.time;
      allow update: if isOwner(uid) && request.resource.data.ts == request.time
                       && (resource.data.ts.year() != request.time.year()
                           || resource.data.ts.month() != request.time.month());
      allow delete: if isStaff();
    }

    // Contador del NÚMERO DE SOCIO (cosmético, NO es dinero). El alta de un socio
    // toma el siguiente número en una transacción (incrementa de a 1). Doc:
    // club_config/contador { n: <int> }. App Check + login limitan el abuso.
    match /club_config/{id} {
      allow read:   if request.auth != null;
      // El branch de admin cubre el toggle de flags (ej. canjeActivo); el otro
      // branch es el contador del nº de socio que incrementa en el alta (+1).
      // Fuera del admin, SOLO el doc 'contador' y SOLO con el campo n. Antes
      // cualquiera logueado podía crear/pisar cualquier doc (p. ej. 'flags')
      // mientras pusiera n == 1.
      allow create: if isAdmin() || (request.auth != null && id == 'contador'
                       && request.resource.data.keys().hasOnly(['n'])
                       && request.resource.data.n == 1);
      allow update: if isAdmin() || (request.auth != null && id == 'contador'
                       && request.resource.data.keys().hasOnly(['n'])
                       && request.resource.data.n == resource.data.n + 1);
      allow delete: if isAdmin();
    }

    // Catálogo de premios: lo VE cualquiera logueado (incluido el cajero, que ahora
    // relee el premio real al validar el voucher); lo ADMINISTRA solo un admin.
    match /premios/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Canjes = VOUCHERS automáticos. El socio emite el voucher ('emitido') y, en el
    // MISMO commit, sus puntos bajan EXACTAMENTE el costo del premio (getAfter). Sin
    // esa baja NO se puede crear → no hay voucher gratis ni dos con el mismo saldo.
    // Anti-estafa: el costo debe coincidir con el del premio real.
    match /canjes/{id} {
      allow get:  if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      // El socio LISTA sus PROPIOS canjes (consulta filtrada por clienteUid) para verlos
      // en "Mis canjes". La condición obliga a que la query esté acotada a su uid: no
      // puede listar los de otro. El personal ve todos.
      allow list: if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      // VOUCHER GANADO EN EL JUEGO. No cuesta puntos, así que no pasa por el
      // control de saldo: lo que lo respalda es la PARTIDA. Solo se puede emitir
      // si existe una partida propia, ya jugada y GANADA, y el premio tiene que
      // ser el mismo que dice esa partida (no se puede pedir otro).
      // El id del voucher ES el id de la partida: una partida ganada emite UN
      // voucher y nada más — el segundo intento choca con el doc que ya existe.
      allow create: if request.auth != null
                       && request.resource.data.get('origen', '') == 'juego'
                       && request.resource.data.clienteUid == request.auth.uid
                       && request.resource.data.partidaId == id
                       && request.resource.data.costo == 0
                       && request.resource.data.usado == false
                       && request.resource.data.estado == 'emitido'
                       && get(/databases/$(database)/documents/partidas/$(id)).data.clienteUid == request.auth.uid
                       && get(/databases/$(database)/documents/partidas/$(id)).data.estado == 'jugada'
                       && get(/databases/$(database)/documents/partidas/$(id)).data.gano == true
                       && request.resource.data.premioNombre == get(/databases/$(database)/documents/partidas/$(id)).data.premioNombre
                       // Vence el mismo día (bases, punto 8).
                       && request.resource.data.venceMs is number
                       && request.resource.data.venceMs > request.time.toMillis()
                       && request.resource.data.venceMs <= request.time.toMillis() + 86400000;

      allow create: if isStaff() || (
                       request.auth != null
                       && request.resource.data.clienteUid == request.auth.uid
                       && request.resource.data.estado == 'emitido'
                       && request.resource.data.usado == false
                       && request.resource.data.costo is int
                       && request.resource.data.costo > 0
                       && request.resource.data.premioId is string
                       // Vencimiento del voucher: máx ~30 días (con margen de reloj). El cliente
                       // NO puede fabricarse uno que "no vence" (el tope usa request.time del servidor).
                       && request.resource.data.venceMs is number
                       && request.resource.data.venceMs > request.time.toMillis()
                       && request.resource.data.venceMs <= request.time.toMillis() + 2764800000
                       // El premio tiene que existir y estar ACTIVO (no se canjea uno dado de baja).
                       && get(/databases/$(database)/documents/premios/$(request.resource.data.premioId)).data.activo == true
                       && request.resource.data.costo == get(/databases/$(database)/documents/premios/$(request.resource.data.premioId)).data.costo
                       // Anti-fraude: el NOMBRE del voucher debe ser el del premio real.
                       // (Sin esto, un socio podía canjear un premio barato pero poner
                       //  el nombre de uno caro y reclamarlo en el mostrador.)
                       && request.resource.data.premioNombre == get(/databases/$(database)/documents/premios/$(request.resource.data.premioId)).data.nombre
                       // Endurecido: el ícono (que NO se valida contra el premio) va
                       // acotado a pocos caracteres → sin lugar para inyectar HTML/JS
                       // que se ejecute en el panel del personal. Nombre/nº de socio
                       // limitados en tamaño (defensa; el panel además los escapa).
                       && (!('premioIco' in request.resource.data) || (request.resource.data.premioIco is string && request.resource.data.premioIco.size() <= 8))
                       && (!('socioNombre' in request.resource.data) || (request.resource.data.socioNombre is string && request.resource.data.socioNombre.size() <= 80))
                       && (!('socioNro' in request.resource.data) || request.resource.data.socioNro is int)
                       // SEGURIDAD "modo intriga": el CANJE solo se permite si el personal lo
                       // habilitó (club_config/flags.canjeActivo == true). Sin esto, un usuario
                       // avanzado podía saltear el "muy pronto" del front y canjear por API directa.
                       && get(/databases/$(database)/documents/club_config/flags).data.get('canjeActivo', false) == true
                       && getAfter(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.puntos == get(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.puntos - request.resource.data.costo
                       // CANDADO MENSUAL: obliga a (re)escribir el lock del premio a ESTE
                       // mes del servidor en el MISMO commit. Si ya hubo un canje de este
                       // premio en el mes actual, el update del lock se rechaza (regla de
                       // /canje_meses) → toda la transacción falla. El mes = request.time.
                       && getAfter(/databases/$(database)/documents/clientes/$(request.auth.uid)/canje_meses/$(request.resource.data.premioId)).data.ts == request.time
                    );
      // Marcar USADO en el mostrador: SOLO personal y SOLO una vez (single-use).
      // Una fotocopia comparte el mismo voucher: el primer escaneo lo anula para todos.
      // Solo se puede marcar usado si NO está vencido (tiempo del SERVIDOR). Un voucher
      // de más de 30 días ya no se acepta en el mostrador.
      allow update: if isStaff() && resource.data.usado == false && request.resource.data.usado == true
                       && resource.data.venceMs > request.time.toMillis();
      // BAJA DE CUENTA (club.html eliminarMiCuenta): el socio anonimiza SUS vouchers
      // (borra nombre y N° de socio) sin tocar nada más. Antes se rechazaba.
      allow update: if request.auth != null && resource.data.clienteUid == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['socioNombre', 'socioNro'])
                       && request.resource.data.socioNombre == ''
                       && request.resource.data.socioNro == 0;
      // Borrar un canje (registro de voucher) = solo admin. El cajero solo lo marca usado.
      allow delete: if isAdmin();
    }

    // Check-in del mostrador: el socio escanea el QR único y "levanta la mano".
    // NO suma puntos (eso lo hace SIEMPRE el personal). El socio crea el suyo en
    // estado 'pendiente'; el personal lo ve, carga los puntos y lo marca atendido.
    // Doc id = uid del socio: una sola visita "viva" por socio (sin duplicados ni
    // índices compuestos). El socio crea/reactiva la suya SIEMPRE en 'pendiente'
    // (re-escanear); NO puede marcarla atendida ni tocar puntos (eso es del staff).
    match /visitas/{id} {
      allow get:  if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      allow list: if isStaff();
      allow create: if isStaff() || (
                       request.auth != null
                       && request.resource.data.clienteUid == request.auth.uid
                       && request.resource.data.estado == 'pendiente'
                    );
      allow update: if isStaff() || (
                       request.auth != null
                       && resource.data.clienteUid == request.auth.uid
                       && request.resource.data.clienteUid == request.auth.uid
                       && request.resource.data.estado == 'pendiente'
                    );
      allow delete: if isStaff();
    }

    // Auditoría de movimientos de puntos: INMUTABLE, solo personal.
    match /puntos_log/{id} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    /* Tickets cargados (id = N° de ticket). ANTI-DUPLICADO: el mismo N° no se
       puede cargar dos veces (la creación falla si ya existe).

       El ticket es el RESPALDO del movimiento de puntos, así que la regla lo
       revisa de verdad:
       · el id del doc tiene que ser el N° que dice adentro (si no, se podría
         guardar el respaldo con un número y declarar otro);
       · los puntos tienen que ser los que salen del monto — 1 cada $100 — escrito
         con multiplicaciones para no depender de cómo divide el motor de reglas;
       · lo carga el empleado que está logueado, no se puede atribuir a otro;
       · y tiene que venir con la FOTO del ticket en el mismo commit. El admin
         queda exento: es el único que puede cargar a mano, sin foto.
       BORRAR: solo un admin. Antes lo podía borrar cualquier staff, y borrar el
       ticket habilitaba volver a cargar el mismo N° (se caía el anti-duplicado). */
    match /tickets/{id} {
      allow read:   if isStaff();
      allow create: if isStaff()
                       && request.resource.data.nro == id
                       && request.resource.data.clienteUid is string
                       && request.resource.data.por == request.auth.uid
                       && request.resource.data.monto is int
                       && request.resource.data.monto > 0
                       && request.resource.data.puntos is int
                       && request.resource.data.puntos > 0
                       && request.resource.data.puntos * 100 <= request.resource.data.monto
                       && (request.resource.data.puntos + 1) * 100 > request.resource.data.monto
                       && (isAdmin() || existsAfter(/databases/$(database)/documents/ticket_fotos/$(id)));
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* La FOTO del ticket, aparte del ticket. Va en su propio documento a
       propósito: /tickets se lee en cada carga (para el anti-duplicado) y en el
       historial del socio, y no tiene sentido arrastrar 200 KB de imagen en cada
       una de esas lecturas. Acá no hay Storage (plan gratis), así que la foto va
       como dataURL comprimido — igual que las promos de la tienda. */
    match /ticket_fotos/{id} {
      allow read:   if isStaff();
      allow create: if isStaff()
                       && request.resource.data.foto is string
                       && request.resource.data.foto.size() > 1000
                       && request.resource.data.foto.size() < 900000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* Cola de REVISIÓN. Cuando el cajero escanea y lo leído NO coincide con el
       ticket que tiene en la mano, no puede corregirlo (no tiene carga manual):
       deja el caso acá con la foto y se lo avisa a los admins. El admin lo mira,
       carga los puntos a mano y lo cierra. El cajero solo puede ABRIR casos. */
    match /revisiones/{id} {
      allow read:   if isStaff();
      allow create: if isStaff()
                       && request.resource.data.por == request.auth.uid
                       && request.resource.data.estado == 'pendiente'
                       && request.resource.data.foto is string
                       && request.resource.data.foto.size() < 900000;
      allow update, delete: if isAdmin();
    }

    // ═══════════════════ JUEGO "DIEZ EXACTO" ═══════════════════
    // Regla de oro: el socio NO decide si ganó ni cuándo puede jugar. El personal
    // habilita la partida (contra ticket) y el SERVIDOR arbitra el resto:
    //   · el objetivo del día lo escribe solo el personal (el socio lo lee);
    //   · el cronómetro se valida contra request.time, no contra el reloj del celular;
    //   · el resultado (ganó / no ganó) lo calcula la regla, no el navegador.

    // Objetivo y premio del día. Lo lee cualquiera logueado; lo escribe SOLO un
    // ADMIN. El cajero no lo toca: define qué se entrega y con qué dificultad, y
    // esa decisión no es del mostrador. El cajero igual lo lee para saber qué
    // premio anunciar.
    match /juego_config/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // CANDADO DIARIO por DOCUMENTO (id = "<dni>_<YYYY-MM-DD>"). Las bases dicen
    // "una partida por persona y por día, computada por número de documento, con
    // independencia del número de socio utilizado": por eso la llave es el DNI y
    // no el uid — abrirse una segunda cuenta de socio no habilita otra partida.
    // Lo crea el PERSONAL al habilitar, y no se puede pisar (create-only).
    // TICKET ÚNICO (id = N° de ticket). Un ticket habilita UNA sola partida y no
    // se puede volver a usar (bases, punto 3). Como el id es el propio número, el
    // segundo intento con el mismo ticket choca contra el doc que ya existe.
    // Es una colección aparte de /tickets: ese es el de la carga de puntos, y un
    // mismo ticket puede sumar puntos Y habilitar una partida.
    match /juego_tickets/{id} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Solo personal: el id lleva el DNI del jugador (antes lo leía cualquiera
    // logueado, incluso anónimo). El socio no lo necesita.
    match /juego_dias/{id} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /partidas/{id} {
      allow get:  if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      allow list: if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);

      // Habilitar la partida: SOLO personal, y ya nace atada al objetivo del día
      // y con vencimiento corto. El socio no puede crearse una partida.
      allow create: if isStaff()
                       && request.resource.data.estado == 'habilitada'
                       && request.resource.data.objetivoMs is int
                       && request.resource.data.objetivoMs == get(/databases/$(database)/documents/juego_config/dia).data.objetivoMs
                       && request.resource.data.venceMs is number
                       && request.resource.data.venceMs > request.time.toMillis()
                       && request.resource.data.venceMs <= request.time.toMillis() + 120000;

      // Dos updates permitidos, y nada más:
      //
      // (1) ARRANCAR — el socio pasa 'habilitada' → 'jugando' y el servidor sella
      //     el inicio con request.time. No puede arrancar una partida vencida.
      allow update: if request.auth != null
                       && resource.data.clienteUid == request.auth.uid
                       && resource.data.estado == 'habilitada'
                       && request.resource.data.estado == 'jugando'
                       && request.resource.data.inicioTs == request.time
                       && resource.data.venceMs > request.time.toMillis()
                       // no puede tocar nada más
                       && request.resource.data.objetivoMs == resource.data.objetivoMs
                       && request.resource.data.clienteUid == resource.data.clienteUid;

      // (2) FRENAR — el socio pasa 'jugando' → 'jugada' y el servidor sella el
      //     fin con request.time. NADA MÁS: el navegador ya no declara su tiempo.
      //     (Antes declaraba tiempoMs y se aceptaba hasta 2 s de diferencia con
      //     lo medido: frenando en cualquier momento entre el objetivo y 2 s
      //     después y declarando el objetivo, se ganaba siempre.)
      allow update: if request.auth != null
                       && resource.data.clienteUid == request.auth.uid
                       && resource.data.estado == 'jugando'
                       && request.resource.data.estado == 'jugada'
                       && request.resource.data.finTs == request.time
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'finTs']);

      // (3) CERRAR — escribir el resultado. Lo único aceptado es la cuenta del
      //     SERVIDOR: tiempoMs = finTs − inicioTs (las dos puntas las puso
      //     request.time) y gano = acierto exacto truncando a la centésima. Como
      //     no hay nada que elegir, lo puede hacer el socio o el personal, una
      //     sola vez (si ya tiene tiempoMs no se toca).
      allow update: if request.auth != null
                       && (resource.data.clienteUid == request.auth.uid || isStaff())
                       && resource.data.estado == 'jugada'
                       && !('tiempoMs' in resource.data)
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tiempoMs', 'gano'])
                       && request.resource.data.tiempoMs is int
                       && request.resource.data.tiempoMs == resource.data.finTs.toMillis() - resource.data.inicioTs.toMillis()
                       && request.resource.data.gano == (
                            (request.resource.data.tiempoMs / 10) == (resource.data.objetivoMs / 10)
                          );

      // Marcar el premio como entregado en el mostrador: solo personal, una vez.
      allow update: if isStaff()
                       && resource.data.estado == 'jugada'
                       && resource.data.gano == true
                       && resource.data.premioEntregado == false
                       && request.resource.data.premioEntregado == true;

      allow delete: if isAdmin();
    }
  }
}
