rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  ⚠️  NO PUBLICAR ESTAS REGLAS HASTA SEMBRAR LA LISTA /staff (abajo).   ║
    // ║  isStaff() ahora exige que el UID esté en /staff/{uid}. Si se publican ║
    // ║  ANTES de cargar los UID del personal, TODO el personal pierde acceso  ║
    // ║  (admin y choferes). Orden correcto:                                   ║
    // ║   1) Crear en la consola Firestore la colección 'staff' con un doc por  ║
    // ║      cada empleado, ID = su UID de Firebase Auth (Authentication→Users).║
    // ║   2) Verificar que admin/chofer siguen entrando.                        ║
    // ║   3) Recién entonces publicar estas reglas.                             ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    // ───────── Identidad ─────────
    // PERSONAL (staff): su UID de Firebase Auth figura en la lista blanca /staff.
    // Antes "staff" = cualquiera no-anónimo; YA NO alcanza, porque los SOCIOS del
    // Club GDO también entran con email+contraseña. Sin esta lista, un cliente
    // tendría permisos de administrador. ← clave anti-estafa.
    // OJO: la colección en Firestore se llama "Staff" con S MAYÚSCULA (así se creó
    // en la consola, y Firestore distingue mayúsculas). Si sumás personal, creá el
    // doc dentro de "Staff" (no "staff"), ID = el UID de Auth del empleado.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/Staff/$(request.auth.uid));
    }
    // Dueño de un documento identificado por UID.
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // ADMIN vs CAJERO/REPARTIDOR. Antes TODO el personal (isStaff) tenía permisos
    // de admin en Firestore; la restricción del cajero era SOLO de interfaz. Ahora
    // las operaciones peligrosas (borrar socios, editar el catálogo de premios,
    // borrar canjes, prender/apagar el canje) exigen isAdmin().
    // RETROCOMPATIBLE: un doc /Staff SIN campo 'rol' cuenta como 'admin' (así
    // publicar estas reglas NO saca permisos a nadie). Para limitar a un cajero,
    // agregá  rol: "cajero"  (o "repartidor") a su doc en /Staff.
    function isAdmin() {
      return isStaff()
        && get(/databases/$(database)/documents/Staff/$(request.auth.uid)).data.get('rol', 'admin') == 'admin';
    }

    // Validación de un pedido creado por la tienda (sesión anónima o socio
    // logueado). Limita lo que un no-staff puede escribir. Si trae clienteUid,
    // debe ser el del propio usuario (para acreditar puntos a quien corresponde).
    function pedidoTiendaValido() {
      let d = request.resource.data;
      return d.origen == 'tienda'
        && d.estado == 'pendiente'
        && d.rutaId == null
        && d.creadoPor == null
        && d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 120
        && d.telefono is string && d.telefono.size() <= 40
        && d.direccion is string && d.direccion.size() <= 300
        && d.especificaciones is string && d.especificaciones.size() <= 2000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 100
        && (!('historia' in d) || (d.historia is list && d.historia.size() == 0))
        && (!('clienteUid' in d) || d.clienteUid == null || d.clienteUid == request.auth.uid)
        // Anti-estafa: el cliente NUNCA fija el monto de puntos a acreditar (lo
        // confirma el personal). totalEstimado es solo informativo.
        && (!('puntos' in d) || d.puntos == 0)
        && (!('puntosAcreditados' in d) || d.puntosAcreditados == false);
    }

    // ───────── Lista blanca de personal ─────────
    // BOOTSTRAP: el primer doc se crea desde la consola (las escrituras de consola
    // saltean las reglas). Después, el personal existente puede sumar más personal.
    // Colección "Staff" con S MAYÚSCULA (ver nota en isStaff()).
    match /Staff/{uid} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // ───────── Datos internos: SOLO personal ─────────
    match /users/{id}          { allow read, write: if isStaff(); }
    match /vehiculos/{id}       { allow read, write: if isStaff(); }
    match /notificaciones/{id}  { allow read, write: if isStaff(); }
    match /meta/{id}            { allow read, write: if isStaff(); }

    // CRM: ficha comercial del cliente (tipo, notas, recordatorios, "ya lo
    // contacté"). NO confundir con /clientes, que es la del socio del GDO CLUB.
    // Datos de contacto de terceros → solo personal, nunca lectura pública.
    match /crm_clientes/{id}    { allow read, write: if isStaff(); }

    // ───────── Pedidos ─────────
    // get: el cliente final ve SU pedido por el link de seguimiento (id de 128
    //      bits, no adivinable). create: personal (cualquier origen) o tienda
    //      (anónimo/socio) si pasa la validación. resto: solo personal.
    match /pedidos/{id} {
      allow get: if true;
      allow create: if isStaff() || (request.auth != null && pedidoTiendaValido());
      allow list, update, delete: if isStaff();
    }

    // ───────── Rutas ─────────
    match /rutas/{id} {
      allow get: if true;
      allow list, create, update, delete: if isStaff();
    }

    // ═══════════════════════ CLUB GDO ═══════════════════════
    // Regla de oro anti-estafa: el SOCIO nunca escribe sus puntos. Solo MIRA su
    // saldo y PIDE canjes. Sumar/restar puntos = SOLO personal (acreditación por
    // entrega o carga manual), y queda registrado en /puntos_log.

    // Perfil + saldo del socio (doc ID = UID de Firebase Auth del socio).
    match /clientes/{uid} {
      allow get:    if isOwner(uid) || isStaff();
      allow list:   if isStaff();
      // Alta: el propio socio, arrancando SIEMPRE en 0 puntos. O el personal.
      allow create: if isStaff() || (isOwner(uid) && request.resource.data.puntos == 0);
      // Update por el socio: puede tocar sus datos y BAJAR puntos (para canjear),
      // NUNCA subirlos (sumar = solo personal) ni cambiar 'nroSocio'. La baja real
      // queda atada a un voucher válido por la regla de /canjes (getAfter).
      // El ADMIN edita todo. El CAJERO (y cualquier staff que no sea admin) SOLO
      // puede mover 'puntos': es lo que necesita para cargar una compra. No puede
      // tocar nombre, DNI, teléfono, email, dirección ni el marcador de demo —
      // antes eso era solo una restricción de pantalla y se podía saltear.
      allow update: if isAdmin()
                    || (isStaff()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puntos']))
                    || (isOwner(uid)
                        && request.resource.data.nroSocio == resource.data.nroSocio
                        && request.resource.data.puntos is int
                        && request.resource.data.puntos >= 0
                        && request.resource.data.puntos <= resource.data.puntos);
      // Borrar la cuenta: un ADMIN, o el PROPIO socio (autoservicio, baja de datos).
      // Un cajero NO borra socios.
      allow delete: if isAdmin() || isOwner(uid);
    }

    // ── Candado "1 canje de cada premio por MES CALENDARIO" (anti cambio de fecha) ──
    // El mes lo decide el SERVIDOR (request.time), NUNCA el reloj del cliente: cambiar
    // la fecha de la PC no sirve. Doc id = premioId; guarda ts = serverTimestamp.
    // Solo se puede (re)escribir si el mes GUARDADO es DISTINTO al mes actual del
    // servidor → no se repite el mismo premio dentro del mismo mes calendario.
    match /clientes/{uid}/canje_meses/{premioId} {
      allow read:   if isOwner(uid) || isStaff();
      allow create: if isOwner(uid) && request.resource.data.ts == request.time;
      allow update: if isOwner(uid) && request.resource.data.ts == request.time
                       && (resource.data.ts.year() != request.time.year()
                           || resource.data.ts.month() != request.time.month());
      allow delete: if isStaff();
    }

    // Contador del NÚMERO DE SOCIO (cosmético, NO es dinero). El alta de un socio
    // toma el siguiente número en una transacción (incrementa de a 1). Doc:
    // club_config/contador { n: <int> }. App Check + login limitan el abuso.
    match /club_config/{id} {
      allow read:   if request.auth != null;
      // El branch de admin cubre el toggle de flags (ej. canjeActivo); el otro
      // branch es el contador del nº de socio que incrementa en el alta (+1).
      allow create: if isAdmin() || (request.auth != null && request.resource.data.n == 1);
      allow update: if isAdmin() || (request.auth != null && request.resource.data.n == resource.data.n + 1);
      allow delete: if isAdmin();
    }

    // Catálogo de premios: lo VE cualquiera logueado (incluido el cajero, que ahora
    // relee el premio real al validar el voucher); lo ADMINISTRA solo un admin.
    match /premios/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Canjes = VOUCHERS automáticos. El socio emite el voucher ('emitido') y, en el
    // MISMO commit, sus puntos bajan EXACTAMENTE el costo del premio (getAfter). Sin
    // esa baja NO se puede crear → no hay voucher gratis ni dos con el mismo saldo.
    // Anti-estafa: el costo debe coincidir con el del premio real.
    match /canjes/{id} {
      allow get:  if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      // El socio LISTA sus PROPIOS canjes (consulta filtrada por clienteUid) para verlos
      // en "Mis canjes". La condición obliga a que la query esté acotada a su uid: no
      // puede listar los de otro. El personal ve todos.
      allow list: if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      // VOUCHER GANADO EN EL JUEGO. No cuesta puntos, así que no pasa por el
      // control de saldo: lo que lo respalda es la PARTIDA. Solo se puede emitir
      // si existe una partida propia, ya jugada y GANADA, y el premio tiene que
      // ser el mismo que dice esa partida (no se puede pedir otro).
      // El id del voucher ES el id de la partida: una partida ganada emite UN
      // voucher y nada más — el segundo intento choca con el doc que ya existe.
      allow create: if request.auth != null
                       && request.resource.data.get('origen', '') == 'juego'
                       && request.resource.data.clienteUid == request.auth.uid
                       && request.resource.data.partidaId == id
                       && request.resource.data.costo == 0
                       && request.resource.data.usado == false
                       && request.resource.data.estado == 'emitido'
                       && get(/databases/$(database)/documents/partidas/$(id)).data.clienteUid == request.auth.uid
                       && get(/databases/$(database)/documents/partidas/$(id)).data.estado == 'jugada'
                       && get(/databases/$(database)/documents/partidas/$(id)).data.gano == true
                       && request.resource.data.premioNombre == get(/databases/$(database)/documents/partidas/$(id)).data.premioNombre
                       // Vence el mismo día (bases, punto 8).
                       && request.resource.data.venceMs is number
                       && request.resource.data.venceMs > request.time.toMillis()
                       && request.resource.data.venceMs <= request.time.toMillis() + 86400000;

      allow create: if isStaff() || (
                       request.auth != null
                       && request.resource.data.clienteUid == request.auth.uid
                       && request.resource.data.estado == 'emitido'
                       && request.resource.data.usado == false
                       && request.resource.data.costo is int
                       && request.resource.data.costo > 0
                       && request.resource.data.premioId is string
                       // Vencimiento del voucher: máx ~30 días (con margen de reloj). El cliente
                       // NO puede fabricarse uno que "no vence" (el tope usa request.time del servidor).
                       && request.resource.data.venceMs is number
                       && request.resource.data.venceMs > request.time.toMillis()
                       && request.resource.data.venceMs <= request.time.toMillis() + 2764800000
                       // El premio tiene que existir y estar ACTIVO (no se canjea uno dado de baja).
                       && get(/databases/$(database)/documents/premios/$(request.resource.data.premioId)).data.activo == true
                       && request.resource.data.costo == get(/databases/$(database)/documents/premios/$(request.resource.data.premioId)).data.costo
                       // Anti-fraude: el NOMBRE del voucher debe ser el del premio real.
                       // (Sin esto, un socio podía canjear un premio barato pero poner
                       //  el nombre de uno caro y reclamarlo en el mostrador.)
                       && request.resource.data.premioNombre == get(/databases/$(database)/documents/premios/$(request.resource.data.premioId)).data.nombre
                       // Endurecido: el ícono (que NO se valida contra el premio) va
                       // acotado a pocos caracteres → sin lugar para inyectar HTML/JS
                       // que se ejecute en el panel del personal. Nombre/nº de socio
                       // limitados en tamaño (defensa; el panel además los escapa).
                       && (!('premioIco' in request.resource.data) || (request.resource.data.premioIco is string && request.resource.data.premioIco.size() <= 8))
                       && (!('socioNombre' in request.resource.data) || (request.resource.data.socioNombre is string && request.resource.data.socioNombre.size() <= 80))
                       && (!('socioNro' in request.resource.data) || request.resource.data.socioNro is int)
                       // SEGURIDAD "modo intriga": el CANJE solo se permite si el personal lo
                       // habilitó (club_config/flags.canjeActivo == true). Sin esto, un usuario
                       // avanzado podía saltear el "muy pronto" del front y canjear por API directa.
                       && get(/databases/$(database)/documents/club_config/flags).data.get('canjeActivo', false) == true
                       && getAfter(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.puntos == get(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.puntos - request.resource.data.costo
                       // CANDADO MENSUAL: obliga a (re)escribir el lock del premio a ESTE
                       // mes del servidor en el MISMO commit. Si ya hubo un canje de este
                       // premio en el mes actual, el update del lock se rechaza (regla de
                       // /canje_meses) → toda la transacción falla. El mes = request.time.
                       && getAfter(/databases/$(database)/documents/clientes/$(request.auth.uid)/canje_meses/$(request.resource.data.premioId)).data.ts == request.time
                    );
      // Marcar USADO en el mostrador: SOLO personal y SOLO una vez (single-use).
      // Una fotocopia comparte el mismo voucher: el primer escaneo lo anula para todos.
      // Solo se puede marcar usado si NO está vencido (tiempo del SERVIDOR). Un voucher
      // de más de 30 días ya no se acepta en el mostrador.
      allow update: if isStaff() && resource.data.usado == false && request.resource.data.usado == true
                       && resource.data.venceMs > request.time.toMillis();
      // Borrar un canje (registro de voucher) = solo admin. El cajero solo lo marca usado.
      allow delete: if isAdmin();
    }

    // Check-in del mostrador: el socio escanea el QR único y "levanta la mano".
    // NO suma puntos (eso lo hace SIEMPRE el personal). El socio crea el suyo en
    // estado 'pendiente'; el personal lo ve, carga los puntos y lo marca atendido.
    // Doc id = uid del socio: una sola visita "viva" por socio (sin duplicados ni
    // índices compuestos). El socio crea/reactiva la suya SIEMPRE en 'pendiente'
    // (re-escanear); NO puede marcarla atendida ni tocar puntos (eso es del staff).
    match /visitas/{id} {
      allow get:  if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      allow list: if isStaff();
      allow create: if isStaff() || (
                       request.auth != null
                       && request.resource.data.clienteUid == request.auth.uid
                       && request.resource.data.estado == 'pendiente'
                    );
      allow update: if isStaff() || (
                       request.auth != null
                       && resource.data.clienteUid == request.auth.uid
                       && request.resource.data.clienteUid == request.auth.uid
                       && request.resource.data.estado == 'pendiente'
                    );
      allow delete: if isStaff();
    }

    // Auditoría de movimientos de puntos: INMUTABLE, solo personal.
    match /puntos_log/{id} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Tickets cargados (id = N° de ticket). ANTI-DUPLICADO: el mismo N° no se puede
    // cargar dos veces (la creación falla si ya existe). Solo personal. No se edita;
    // el staff puede borrar para corregir un error de carga.
    match /tickets/{id} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if false;
      allow delete: if isStaff();
    }

    // ═══════════════════ JUEGO "DIEZ EXACTO" ═══════════════════
    // Regla de oro: el socio NO decide si ganó ni cuándo puede jugar. El personal
    // habilita la partida (contra ticket) y el SERVIDOR arbitra el resto:
    //   · el objetivo del día lo escribe solo el personal (el socio lo lee);
    //   · el cronómetro se valida contra request.time, no contra el reloj del celular;
    //   · el resultado (ganó / no ganó) lo calcula la regla, no el navegador.

    // Objetivo y premio del día. Lo lee cualquiera logueado; lo escribe SOLO un
    // ADMIN. El cajero no lo toca: define qué se entrega y con qué dificultad, y
    // esa decisión no es del mostrador. El cajero igual lo lee para saber qué
    // premio anunciar.
    match /juego_config/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // CANDADO DIARIO por DOCUMENTO (id = "<dni>_<YYYY-MM-DD>"). Las bases dicen
    // "una partida por persona y por día, computada por número de documento, con
    // independencia del número de socio utilizado": por eso la llave es el DNI y
    // no el uid — abrirse una segunda cuenta de socio no habilita otra partida.
    // Lo crea el PERSONAL al habilitar, y no se puede pisar (create-only).
    // TICKET ÚNICO (id = N° de ticket). Un ticket habilita UNA sola partida y no
    // se puede volver a usar (bases, punto 3). Como el id es el propio número, el
    // segundo intento con el mismo ticket choca contra el doc que ya existe.
    // Es una colección aparte de /tickets: ese es el de la carga de puntos, y un
    // mismo ticket puede sumar puntos Y habilitar una partida.
    match /juego_tickets/{id} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /juego_dias/{id} {
      allow read:   if isStaff() || request.auth != null;
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /partidas/{id} {
      allow get:  if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      allow list: if isStaff() || (request.auth != null && resource.data.clienteUid == request.auth.uid);

      // Habilitar la partida: SOLO personal, y ya nace atada al objetivo del día
      // y con vencimiento corto. El socio no puede crearse una partida.
      allow create: if isStaff()
                       && request.resource.data.estado == 'habilitada'
                       && request.resource.data.objetivoMs is int
                       && request.resource.data.objetivoMs == get(/databases/$(database)/documents/juego_config/dia).data.objetivoMs
                       && request.resource.data.venceMs is number
                       && request.resource.data.venceMs > request.time.toMillis()
                       && request.resource.data.venceMs <= request.time.toMillis() + 120000;

      // Dos updates permitidos, y nada más:
      //
      // (1) ARRANCAR — el socio pasa 'habilitada' → 'jugando' y el servidor sella
      //     el inicio con request.time. No puede arrancar una partida vencida.
      allow update: if request.auth != null
                       && resource.data.clienteUid == request.auth.uid
                       && resource.data.estado == 'habilitada'
                       && request.resource.data.estado == 'jugando'
                       && request.resource.data.inicioTs == request.time
                       && resource.data.venceMs > request.time.toMillis()
                       // no puede tocar nada más
                       && request.resource.data.objetivoMs == resource.data.objetivoMs
                       && request.resource.data.clienteUid == resource.data.clienteUid;

      // (2) FRENAR — el socio pasa 'jugando' → 'jugada' informando su tiempo.
      //     ACÁ ESTÁ EL ANTI-TRAMPA: el tiempo declarado se contrasta contra lo que
      //     midió el SERVIDOR (request.time - inicioTs). No puede declarar menos de
      //     lo que realmente tardó, y se le permite hasta 2 s de más por la latencia
      //     de red. Cambiar la hora del celular no sirve: ninguna de las dos puntas
      //     de la medición la pone el celular.
      //     Y 'gano' no lo decide el navegador: la regla exige que sea exactamente
      //     la comparación contra el objetivo del día, truncando a la centésima.
      allow update: if request.auth != null
                       && resource.data.clienteUid == request.auth.uid
                       && resource.data.estado == 'jugando'
                       && request.resource.data.estado == 'jugada'
                       && request.resource.data.tiempoMs is int
                       && request.resource.data.tiempoMs >= 0
                       && request.resource.data.tiempoMs <= request.time.toMillis() - resource.data.inicioTs.toMillis()
                       && request.resource.data.tiempoMs >= request.time.toMillis() - resource.data.inicioTs.toMillis() - 2000
                       && request.resource.data.finTs == request.time
                       && request.resource.data.gano == (
                            (request.resource.data.tiempoMs / 10) == (resource.data.objetivoMs / 10)
                          )
                       && request.resource.data.objetivoMs == resource.data.objetivoMs
                       && request.resource.data.clienteUid == resource.data.clienteUid;

      // Marcar el premio como entregado en el mostrador: solo personal, una vez.
      allow update: if isStaff()
                       && resource.data.estado == 'jugada'
                       && resource.data.gano == true
                       && resource.data.premioEntregado == false
                       && request.resource.data.premioEntregado == true;

      allow delete: if isAdmin();
    }
  }
}
